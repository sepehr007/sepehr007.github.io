# HTTP
PORT=3001
HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API.
# Leave empty only in development; set the real site origin in production.
# Example: CORS_ORIGIN=https://sepehr007.github.io,http://localhost:8123
CORS_ORIGIN=

# Required in production (the server refuses to start without it)
JWT_SECRET=replace_with_a_long_random_string

# Databases (Redis is optional; sessions and rate limits fall back to memory)
MONGO_URI=mongodb://localhost:27017/qoder
REDIS_URL=redis://localhost:6379

# One-time owner seed, used by `npm run seed` on an empty database.
# Keep the backend password in sync with the owner console password.
OWNER_EMAIL=owner@qoder.local
OWNER_USERNAME=owner
OWNER_PASSWORD=A9!xK2@pL5#vN8$

# Public site origin used in email links (verify / reset).
APP_ORIGIN=https://sepehr007.github.io

# Email delivery. Without SMTP_HOST the server writes mails to
# DATA_DIR/mail-outbox.jsonl instead (useful for local testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=هم‌تماشا <no-reply@hammatama.ir>

# Require an 8-digit email confirmation before the first login.
# Set to false/off/0 to allow unverified logins.
REQUIRE_EMAIL_VERIFICATION=true

# SMS delivery for "forgot password" (optional).
# Without these the server writes SMS to DATA_DIR/sms-outbox.jsonl.
# The owner console (ایمیل و پیامک) can override these at runtime and is
# the recommended way to connect a gateway without editing .env.
# SMS_PROVIDER: kavenegar | twilio | webhook
SMS_PROVIDER=
# Kavenegar: API key + optional sender line.
SMS_API_KEY=
SMS_SENDER=
# Custom webhook: receives POST JSON { to, message, sender, apiKey, site }.
SMS_WEBHOOK_URL=
# Twilio: Account SID, auth token and sender number.
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=

# Where SQLite + mail/sms outbox live (defaults to server/data).
DATA_DIR=
# SQLite file (defaults to DATA_DIR/wt.sqlite). SQLite is the primary
# relational store whenever MONGO_URI is not reachable.
SQLITE_FILE=
# Backup folder (defaults to DATA_DIR/backups).
BACKUP_DIR=

# Database tuning (optional)
DB_BUSY_TIMEOUT_MS=5000
# How many generated wt-*.sqlite backups to keep (0 = unlimited).
BACKUP_KEEP=30
# Automatic backup interval in hours when the newest backup is missing/stale (0 = off).
AUTO_BACKUP_HOURS=24
# Maintenance loop interval (retention pruning + backup checks), milliseconds.
MAINTENANCE_INTERVAL_MS=21600000

# Retention windows in days (safe deletion of old operational rows only).
RETENTION_SESSION_GRACE_DAYS=7
RETENTION_AUDIT_DAYS=365
RETENTION_ANALYTICS_DAYS=90
RETENTION_PLAYBACK_DAYS=365
RETENTION_NOTIFICATION_DAYS=90
# Chat retention is off by default; set a positive number to archive older
# messages out of the hot table. User data is never dropped silently.
RETENTION_MESSAGE_DAYS=0
