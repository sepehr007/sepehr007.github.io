# ===== Runtime environment =====
# development | staging | production
# staging and production refuse to start without JWT_SECRET and never use "*" CORS.
APP_ENV=development
LOG_LEVEL=info

# ===== HTTP =====
PORT=3001
HOST=0.0.0.0

# true when running behind nginx/Caddy; false if the port is exposed directly.
TRUST_PROXY=true

# Comma-separated browser origins allowed to call the API.
# When empty the server falls back to APP_ORIGIN. Outside development an
# empty list means same-origin only (never a wildcard).
# Example: CORS_ORIGIN=https://site.example.com,http://localhost:8123
CORS_ORIGIN=

# Required outside development. Generate with: openssl rand -base64 48
JWT_SECRET=

# Public site origin used in verification and reset links.
# PUBLIC_URL is accepted as an alias. Set the real domain per deployment.
# Example: APP_ORIGIN=https://sepehr007.github.io
APP_ORIGIN=

# Rate limits for unauthenticated/API traffic (per IP per window).
RATE_LIMIT_MAX=50
RATE_LIMIT_WINDOW_MS=60000

# ===== Data stores =====
# SQLite is the primary relational store and always runs.
# Mongo and Redis are optional and only needed to scale beyond one node.
MONGO_URI=
REDIS_URL=

# Feature governance caches (milliseconds). Admin writes clear them instantly.
FEATURE_CACHE_MS=5000
FEATURE_SCOPE_CACHE_MS=3000

# Hard floors no admin toggle can lift (comma-separated feature keys).
# SECURITY_MANDATORY_OFF=features.screenShare
# FEATURE_EMERGENCY_OFF=

# ===== Storage =====
# Where SQLite, backups and mail/sms outboxes live (defaults to server/data).
DATA_DIR=
# SQLite file (defaults to DATA_DIR/wt.sqlite).
SQLITE_FILE=
# Backup folder (defaults to DATA_DIR/backups).
BACKUP_DIR=

# Upload quotas in megabytes (per user / whole instance). Files live in DATA_DIR/uploads.
UPLOAD_USER_QUOTA_MB=60
UPLOAD_GLOBAL_QUOTA_MB=2048

# Re-open SQLite after a failed start (milliseconds). 0 disables.
# Default: 15000 outside development, 0 in development.
DB_RETRY_MS=

# Database tuning
DB_BUSY_TIMEOUT_MS=5000
# How many generated *.sqlite backups to keep (0 = unlimited).
BACKUP_KEEP=30
# Automatic backup interval in hours when the newest backup is missing/stale (0 = off).
AUTO_BACKUP_HOURS=24
# Maintenance loop interval (retention pruning + backup checks), milliseconds.
MAINTENANCE_INTERVAL_MS=21600000

# Retention windows in days (safe deletion of old operational rows only).
RETENTION_SESSION_GRACE_DAYS=7
RETENTION_AUDIT_DAYS=365
RETENTION_ANALYTICS_DAYS=90
RETENTION_PLAYBACK_DAYS=365
RETENTION_NOTIFICATION_DAYS=90
# Chat retention is off by default; set a positive number to archive older
# messages out of the hot table. User data is never dropped silently.
RETENTION_MESSAGE_DAYS=0

# ===== Owner seed (npm run seed, empty database only) =====
# Set a unique password before the first production deploy and keep it out of git.
OWNER_EMAIL=owner@qoder.local
OWNER_USERNAME=owner
OWNER_PASSWORD=change_me_before_deploying

# ===== Email =====
# Without SMTP_HOST the server writes mails to DATA_DIR/mail-outbox.jsonl.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=هم‌تماشا <no-reply@hammatama.ir>

# Require an 8-digit email confirmation before the first login.
# Set to false/off/0 to allow unverified logins.
REQUIRE_EMAIL_VERIFICATION=true

# ===== SMS =====
# Without these the server writes SMS to DATA_DIR/sms-outbox.jsonl.
# The owner console (ایمیل و پیامک) can override these at runtime.
# SMS_PROVIDER: kavenegar | twilio | webhook
SMS_PROVIDER=
# Kavenegar: API key + optional sender line.
SMS_API_KEY=
SMS_SENDER=
# Custom webhook: receives POST JSON { to, message, sender, apiKey, site }.
SMS_WEBHOOK_URL=
# Twilio: Account SID, auth token and sender number.
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=
